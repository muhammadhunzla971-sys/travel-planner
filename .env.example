# Copy to backend/.env for local dev (optional). On Vercel, set these under
# Project -> Settings -> Environment Variables. NEVER commit a real key.
ENVIRONMENT=development
CORS_ORIGINS=*

# LLM (Groq, free tier). Only GROQ_API_KEY is required; the rest have defaults.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true
LLM_TIMEOUT_S=8

# Optional: accounts + saved trips (Supabase free plan). Both values are public by design.
SUPABASE_URL=
SUPABASE_ANON_KEY=
